# Copy this file to .env on the VM and fill in real values.
# .env is used by docker-compose.prod.yml (docker compose automatically reads a .env file
# in the same directory as the compose file).

# A long, random, unguessable secret used to sign JWT tokens.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# The public domain name that points at this VM's public IP address (see the DNS step
# in the deployment guide). Caddy will automatically obtain a free HTTPS certificate
# for this domain from Let's Encrypt, and the frontend will be built to call the API
# at this same domain (no separate backend URL needed).
PUBLIC_DOMAIN=yourapp.duckdns.org

# Password for the PostgreSQL database user (used by docker-compose.prod.yml).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Translation: nllb runs locally; google uses Cloud Translation Basic (NMT).
# The backend reads the root .env file, with terminal variables taking priority.
TRANSLATION_PROVIDER=nllb
GOOGLE_TRANSLATE_API_KEY=
